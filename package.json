{
  "name": "team-sight",
  "version": "0.1.0",
  "description": "TAPD 跨项目团队排期看板",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:secrets": "node scripts/check-secrets.mjs",
    "verify:tapd": "node scripts/verify-tapd.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "p0:build": "pnpm --filter @teamsight/mcp-ui build && pnpm --filter @teamsight/server build",
    "p0:test": "pnpm --filter @teamsight/server test",
    "p0:serve": "node apps/server/dist/cli.js serve",
    "p0:package": "node scripts/package-p0.mjs"
    ,"p1a:build": "pnpm --filter @teamsight/core build && pnpm --filter @teamsight/tapd build && pnpm --filter @teamsight/server build && pnpm --filter @teamsight/mcp-ui build"
    ,"p1a:test": "pnpm --filter @teamsight/core test && pnpm --filter @teamsight/tapd test && pnpm --filter @teamsight/server test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  },
  "keywords": [],
  "author": "HaolinHom",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
