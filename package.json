{
  "name": "team-sight",
  "version": "0.3.5",
  "description": "TeamSight MCP：TAPD 排期、工时与团队分析",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm mcp:build",
    "test": "pnpm mcp:test",
    "verify:secrets": "node scripts/check-secrets.mjs",
    "verify:tapd": "node scripts/verify-tapd.mjs",
    "mcp:build": "pnpm --filter @teamsight/core build && pnpm --filter @teamsight/tapd build && pnpm --filter @teamsight/server build && pnpm --filter @teamsight/mcp-ui build",
    "mcp:test": "pnpm --filter @teamsight/core test && pnpm --filter @teamsight/tapd test && pnpm --filter @teamsight/server test && pnpm --filter @teamsight/mcp-ui test && node --test scripts/test/*.test.mjs",
    "mcp:serve": "node apps/server/dist/cli.js serve",
    "mcp:package": "node scripts/package-mcp.mjs",
    "mcp:package:verify": "node scripts/verify-mcp-packages.mjs",
    "mcp:installer:windows:build": "node scripts/build-windows-manager.mjs",
    "mcp:installer:windows:verify": "node scripts/verify-windows-installer.mjs",
    "mcp:installer:windows:pages": "node scripts/build-windows-pages.mjs",
    "mcp:installer:windows:verify-pages": "node scripts/verify-windows-pages.mjs",
    "mcp:installer:build": "node scripts/build-installer.mjs",
    "mcp:installer:verify": "node scripts/verify-http-installer.mjs",
    "mcp:installer:prepare": "node scripts/prepare-installer-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "0.25.12",
    "toml-eslint-parser": "1.0.3",
    "typescript": "^5.7.3",
    "yazl": "3.3.1"
  },
  "keywords": [],
  "author": "HaolinHom",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
