{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeamSight",
  "version": "0.1.0",
  "identifier": "com.haolinhom.team-sight",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TeamSight · TAPD 团队排期看板",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
